# ------------------------------------------------------------
# Ontology Playground Environment Configuration
# ------------------------------------------------------------

# Enable AI-powered Ontology Builder (set to true to show the AI Builder button)
VITE_ENABLE_AI_BUILDER=true

# Legacy format export/import (JSON/YAML/CSV)
VITE_ENABLE_LEGACY_FORMATS=true

# GitHub OAuth Client ID for PR submissions (optional)
VITE_GITHUB_CLIENT_ID=

# ------------------------------------------------------------
# OpenAI / Compatible Third-Party Provider Configuration
# (Supported providers: DeepSeek, OneAPI, OpenAI, Qwen, SiliconFlow, etc.)
# ------------------------------------------------------------
# Base URL for OpenAI-compatible API (e.g. https://api.openai.com/v1 or https://api.deepseek.com/v1)
OPENAI_BASE_URL=https://zeke-cli-proxy-api-latest.onrender.com/v1/chat/completions

# API Key for the provider (Keep secret! Use .env.local for local overrides)
OPENAI_API_KEY=your-api-key-1

# Model name (e.g. gpt-4o-mini, deepseek-chat, qwen-plus)
OPENAI_MODEL=gemini-pro-agent

# ------------------------------------------------------------
# Azure OpenAI Configuration (Fallback / Alternative)
# ------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
